<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <IntermediateOutputPath>obj\Library32\$(Configuration)\</IntermediateOutputPath>
    <ApplicationId>com.rpgprototype.app</ApplicationId>
    <ApplicationTitle>RPG Prototype</ApplicationTitle>
    <AssemblyName>RPGPrototype</AssemblyName>
    <RootNamespace>BeatEngine.Android</RootNamespace>
    <Title>RPGPrototype</Title>
    <Product>RPGPrototype</Product>
    <Company>RPGPrototype</Company>
    <Description>RPGPrototype</Description>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <Platforms>AnyCPU;ARM64</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <AndroidResource Remove="Resources\Drawable\Splash.png;Resources\Drawable\Icon.png" />
    <AndroidResource Include="Resources\Drawable\rpg_mark.xml" />
    <AndroidResource Include="Resources\Drawable\splash_background.xml" />
    <AndroidResource Include="Resources\Drawable\splash_icon.xml" />
    <AndroidResource Include="Resources\Values\Styles.xml" />
    <AndroidResource Include="Resources\Values\Strings.xml" />
    <AndroidResource Include="Resources\Values-v31\Styles.xml" />
  </ItemGroup>
  <ItemGroup>
    <MonoGameContentReference OutputFolder="Library32" Include="..\BeatEngine.Core\Content\BeatEngine.mgcb" Link="Content\BeatEngine.mgcb" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BeatEngine.Core\BeatEngine.Core.csproj" />
  </ItemGroup>  
  <ItemGroup>
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.4" />
    <PackageReference Include="MonoGame.Framework.Android" Version="3.8.4" />
  </ItemGroup>
  <Target Name="RestoreDotnetTools" BeforeTargets="CollectPackageReferences">
    <Message Text="Restoring dotnet tools (this might take a while depending on your internet speed and should only happen upon building your project for the first time, or after upgrading MonoGame, or clearing your nuget cache)" Importance="High" />
    <Exec Command="dotnet tool restore" />
  </Target>
</Project>
