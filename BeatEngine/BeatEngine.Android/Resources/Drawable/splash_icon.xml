<?xml version="1.0" encoding="utf-8"?>
<!-- Scale with the system's icon bounds instead of fixing the logo width in dp.
     The centered logo occupies half the square's width, safely inside its mask.
     Vertical padding preserves the 1080:620 menu logo aspect ratio. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="25%"
    android:insetRight="25%"
    android:insetTop="35.648148%"
    android:insetBottom="35.648148%">
  <bitmap android:src="@drawable/splash" android:gravity="fill" />
</inset>
